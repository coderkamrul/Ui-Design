# Supabase connection (optional — without these the app runs in local
# mode on localStorage and no sign-in exists).
#
# Copy this file to .env.local and fill in the two values from your
# Supabase project: Dashboard → Project Settings → API.
#   - NEXT_PUBLIC_SUPABASE_URL:       the "Project URL"
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY:  the "anon public" key
# The anon key is safe to expose in the browser — Row Level Security
# (supabase/schema.sql) enforces owner-only access. Never put the
# service_role key in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
